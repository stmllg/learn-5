[
  {
    "id": 1,
    "text": "兜率眾神頌",
    "start": 1.0,
    "end": 3.05
  },
  {
    "id": 2,
    "text": "從於兜率眾神依怙心",
    "start": 3.05,
    "end": 6.89
  },
  {
    "id": 3,
    "text": "湧出新酪纍纍白雲端",
    "start": 6.89,
    "end": 10.3
  },
  {
    "id": 4,
    "text": "遍智法王妙慧賢善稱",
    "start": 10.3,
    "end": 13.89
  },
  {
    "id": 5,
    "text": "願同法子於此降來臨",
    "start": 13.89,
    "end": 17.45
  },
  {
    "id": 6,
    "text": "面前虛空獅子蓮月座",
    "start": 17.45,
    "end": 20.73
  },
  {
    "id": 7,
    "text": "至尊上師熙怡晏然住",
    "start": 20.73,
    "end": 24.53
  },
  {
    "id": 8,
    "text": "我心皈信無上勝福田",
    "start": 24.53,
    "end": 28.07
  },
  {
    "id": 9,
    "text": "為弘聖教祈願住百劫",
    "start": 28.07,
    "end": 31.66
  },
  {
    "id": 10,
    "text": "遍了一切所知明慧意",
    "start": 31.66,
    "end": 35.22
  },
  {
    "id": 11,
    "text": "賢士耳根莊嚴妙善語",
    "start": 35.22,
    "end": 38.72
  },
  {
    "id": 12,
    "text": "德名稱頌晃耀端嚴身",
    "start": 38.72,
    "end": 42.2
  },
  {
    "id": 13,
    "text": "見聞憶念得益我敬禮",
    "start": 42.2,
    "end": 45.73
  },
  {
    "id": 14,
    "text": "種種悅意妙供姝麗花",
    "start": 45.73,
    "end": 49.23
  },
  {
    "id": 15,
    "text": "馥郁薰香燈明香水等",
    "start": 49.23,
    "end": 52.78
  },
  {
    "id": 16,
    "text": "如是實設意化供雲海",
    "start": 52.78,
    "end": 56.19
  },
  {
    "id": 17,
    "text": "供養最勝福田上師尊",
    "start": 56.19,
    "end": 59.77
  },
  {
    "id": 18,
    "text": "我從無始時來廣積集",
    "start": 59.77,
    "end": 63.42
  },
  {
    "id": 19,
    "text": "身語意三所作一切惡",
    "start": 63.42,
    "end": 66.86
  },
  {
    "id": 20,
    "text": "特於三部律儀違越品",
    "start": 66.86,
    "end": 70.55
  },
  {
    "id": 21,
    "text": "至心痛悔猛勵各各懺",
    "start": 70.55,
    "end": 74.09
  },
  {
    "id": 22,
    "text": "於此濁世多聞勤修習",
    "start": 74.09,
    "end": 77.72
  },
  {
    "id": 23,
    "text": "斷除八風暇滿令有義",
    "start": 77.72,
    "end": 81.19
  },
  {
    "id": 24,
    "text": "至尊依怙宏偉諸事業",
    "start": 81.19,
    "end": 84.69
  },
  {
    "id": 25,
    "text": "我等至心繫念作隨喜",
    "start": 84.69,
    "end": 88.36
  },
  {
    "id": 26,
    "text": "具德無上最勝諸師尊",
    "start": 88.36,
    "end": 92.03
  },
  {
    "id": 27,
    "text": "法身虛空滿佈悲智雲",
    "start": 92.03,
    "end": 95.66
  },
  {
    "id": 28,
    "text": "而於隨宜相應所化地",
    "start": 95.66,
    "end": 99.03
  },
  {
    "id": 29,
    "text": "祈願任運普降正法雨",
    "start": 99.03,
    "end": 102.63
  },
  {
    "id": 30,
    "text": "盡我所有積集諸善根",
    "start": 102.63,
    "end": 106.13
  },
  {
    "id": 31,
    "text": "興隆正法饒益眾有情",
    "start": 106.13,
    "end": 109.82
  },
  {
    "id": 32,
    "text": "尤願至尊善慧名稱師",
    "start": 109.82,
    "end": 113.28
  },
  {
    "id": 33,
    "text": "聖教心要恆常普光映",
    "start": 113.28,
    "end": 116.84
  }
]