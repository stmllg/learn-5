[
  {
    "id": 1,
    "text": "入行論第五品護正知",
    "start": 3.2,
    "end": 5.4
  },
  {
    "id": 2,
    "text": "欲護學處者，策勵當護心；",
    "start": 5.4,
    "end": 8.2
  },
  {
    "id": 3,
    "text": "若不護此心，不能護學處。",
    "start": 8.2,
    "end": 10.94
  },
  {
    "id": 4,
    "text": "若縱狂象心，受難無間獄；",
    "start": 10.94,
    "end": 13.9
  },
  {
    "id": 5,
    "text": "未馴大狂象，為患不及此。",
    "start": 13.9,
    "end": 16.42
  },
  {
    "id": 6,
    "text": "若以正念索，緊拴狂象心，",
    "start": 16.42,
    "end": 19.27
  },
  {
    "id": 7,
    "text": "怖畏盡消除，福善悉獲至。",
    "start": 19.27,
    "end": 22.1
  },
  {
    "id": 8,
    "text": "虎獅大象熊、蛇及一切敵、",
    "start": 22.1,
    "end": 25.01
  },
  {
    "id": 9,
    "text": "有情地獄卒、惡神並羅剎，",
    "start": 25.01,
    "end": 27.67
  },
  {
    "id": 10,
    "text": "唯由繫此心，即攝彼一切；",
    "start": 27.67,
    "end": 30.4
  },
  {
    "id": 11,
    "text": "調伏此一心，一切皆馴服。",
    "start": 30.4,
    "end": 33.19
  },
  {
    "id": 12,
    "text": "實語者佛言：一切諸畏懼、",
    "start": 33.19,
    "end": 35.95
  },
  {
    "id": 13,
    "text": "無量眾苦痛，皆從心所生。",
    "start": 35.95,
    "end": 38.78
  },
  {
    "id": 14,
    "text": "有情獄兵器，施設何人意？",
    "start": 38.78,
    "end": 41.42
  },
  {
    "id": 15,
    "text": "誰製燒鐵地？妖女從何出？",
    "start": 41.42,
    "end": 44.27
  },
  {
    "id": 16,
    "text": "佛說彼一切，皆由惡心造。",
    "start": 44.27,
    "end": 47.04
  },
  {
    "id": 17,
    "text": "是故三界中，恐怖莫甚心。",
    "start": 47.04,
    "end": 49.82
  },
  {
    "id": 18,
    "text": "若除眾生貧，始圓施度者，",
    "start": 49.82,
    "end": 52.87
  },
  {
    "id": 19,
    "text": "今猶見飢貧，昔佛云何成？",
    "start": 52.87,
    "end": 55.7
  },
  {
    "id": 20,
    "text": "心樂與眾生，身財及果德，",
    "start": 55.7,
    "end": 58.44
  },
  {
    "id": 21,
    "text": "僅此施度圓，故施唯依心。",
    "start": 58.44,
    "end": 61.32
  },
  {
    "id": 22,
    "text": "護魚至何方，始得不遭傷？",
    "start": 61.32,
    "end": 64.12
  },
  {
    "id": 23,
    "text": "斷盡惡心時，說為戒度圓。",
    "start": 64.12,
    "end": 67.0
  },
  {
    "id": 24,
    "text": "頑者如虛空，豈能盡制彼？",
    "start": 67.0,
    "end": 69.77
  },
  {
    "id": 25,
    "text": "若息此瞋心，則同滅眾敵。",
    "start": 69.77,
    "end": 72.72
  },
  {
    "id": 26,
    "text": "何需足量革，盡覆此大地？",
    "start": 72.72,
    "end": 75.48
  },
  {
    "id": 27,
    "text": "片革墊靴底，即同覆大地。",
    "start": 75.48,
    "end": 78.26
  },
  {
    "id": 28,
    "text": "如是吾不克，盡制諸外敵；",
    "start": 78.26,
    "end": 81.0
  },
  {
    "id": 29,
    "text": "唯應伏此心，何勞制其餘？",
    "start": 81.0,
    "end": 84.19
  },
  {
    "id": 30,
    "text": "生一明定心，亦得梵天果。",
    "start": 84.19,
    "end": 86.9
  },
  {
    "id": 31,
    "text": "身口善縱勤，心弱難成就。",
    "start": 86.9,
    "end": 89.83
  },
  {
    "id": 32,
    "text": "雖久習唸誦，及餘眾苦行，",
    "start": 89.83,
    "end": 92.66
  },
  {
    "id": 33,
    "text": "然心散它處，佛說彼無益。",
    "start": 92.66,
    "end": 95.33
  },
  {
    "id": 34,
    "text": "若不知此心奧秘法中尊，",
    "start": 95.33,
    "end": 97.92
  },
  {
    "id": 35,
    "text": "求樂或避苦，無義終漂泊。",
    "start": 97.92,
    "end": 100.92
  },
  {
    "id": 36,
    "text": "故吾當善持、善護此道心；",
    "start": 100.92,
    "end": 103.63
  },
  {
    "id": 37,
    "text": "除此護心戒，何勞戒其餘？",
    "start": 103.63,
    "end": 106.85
  },
  {
    "id": 38,
    "text": "如處亂眾中，人皆慎護瘡；",
    "start": 106.85,
    "end": 109.58
  },
  {
    "id": 39,
    "text": "置身惡人群，常護此心傷。",
    "start": 109.58,
    "end": 112.03
  },
  {
    "id": 40,
    "text": "若懼小瘡痛，猶慎護瘡傷；",
    "start": 112.03,
    "end": 115.1
  },
  {
    "id": 41,
    "text": "畏山夾毀者，何不護心傷？",
    "start": 115.1,
    "end": 117.6
  },
  {
    "id": 42,
    "text": "行持若如斯，縱住惡人群，",
    "start": 117.6,
    "end": 120.62
  },
  {
    "id": 43,
    "text": "抑處美人窩，勤律終不退。",
    "start": 120.62,
    "end": 123.43
  },
  {
    "id": 44,
    "text": "吾寧失利養、資身眾活計，",
    "start": 123.43,
    "end": 126.05
  },
  {
    "id": 45,
    "text": "亦寧失餘善，終不損此心。",
    "start": 126.05,
    "end": 129.38
  },
  {
    "id": 46,
    "text": "合掌誠勸請，欲護自心者，",
    "start": 129.38,
    "end": 132.22
  },
  {
    "id": 47,
    "text": "致力恆守護，正念與正知。",
    "start": 132.22,
    "end": 135.05
  },
  {
    "id": 48,
    "text": "身疾所困者，無力為諸業；",
    "start": 135.05,
    "end": 137.89
  },
  {
    "id": 49,
    "text": "如是惑擾心，無力成善業。",
    "start": 137.89,
    "end": 140.65
  },
  {
    "id": 50,
    "text": "心無正知者，聞思修所得，",
    "start": 140.65,
    "end": 143.61
  },
  {
    "id": 51,
    "text": "如漏瓶中水，不復住正念。",
    "start": 143.61,
    "end": 146.4
  },
  {
    "id": 52,
    "text": "縱信復多聞，數數勤精進，",
    "start": 146.4,
    "end": 149.76
  },
  {
    "id": 53,
    "text": "然因無正知，終染犯墮垢。",
    "start": 149.76,
    "end": 152.5
  },
  {
    "id": 54,
    "text": "惑賊不正知，尾隨念失後，",
    "start": 152.5,
    "end": 155.34
  },
  {
    "id": 55,
    "text": "盜昔所聚福，令墮諸惡趣。",
    "start": 155.34,
    "end": 158.18
  },
  {
    "id": 56,
    "text": "此群煩惱賊，尋隙欲打劫，",
    "start": 158.18,
    "end": 161.14
  },
  {
    "id": 57,
    "text": "得便奪善財，復毀善趣命。",
    "start": 161.14,
    "end": 164.33
  },
  {
    "id": 58,
    "text": "故終不稍縱，正念離意門，",
    "start": 164.33,
    "end": 166.84
  },
  {
    "id": 59,
    "text": "離則思諸患，復住於正念。",
    "start": 166.84,
    "end": 169.8
  },
  {
    "id": 60,
    "text": "恆隨上師尊，畏墮聞法語，",
    "start": 169.8,
    "end": 172.72
  },
  {
    "id": 61,
    "text": "易令善信者，恆常生正念。",
    "start": 172.72,
    "end": 175.54
  },
  {
    "id": 62,
    "text": "佛及菩薩眾，無礙見一切，",
    "start": 175.54,
    "end": 178.56
  },
  {
    "id": 63,
    "text": "故吾諸言行，必現彼等前。",
    "start": 178.56,
    "end": 181.42
  },
  {
    "id": 64,
    "text": "如是思惟已，則生慚敬畏；",
    "start": 181.42,
    "end": 184.32
  },
  {
    "id": 65,
    "text": "循此復極易，慇慇隨念佛。",
    "start": 184.32,
    "end": 187.13
  },
  {
    "id": 66,
    "text": "為護心意門，安住正念已，",
    "start": 187.13,
    "end": 189.54
  },
  {
    "id": 67,
    "text": "正知即隨臨，逝者亦復返。",
    "start": 189.54,
    "end": 192.57
  },
  {
    "id": 68,
    "text": "心意初生際，知其有過已，",
    "start": 192.57,
    "end": 195.43
  },
  {
    "id": 69,
    "text": "即時護正念，堅持住如樹。",
    "start": 195.43,
    "end": 198.14
  },
  {
    "id": 70,
    "text": "吾終不應當，無義散漫望；",
    "start": 198.14,
    "end": 201.16
  },
  {
    "id": 71,
    "text": "決志當恆常，垂眼目微張。",
    "start": 201.16,
    "end": 204.07
  },
  {
    "id": 72,
    "text": "蘇息吾眼故，偶宜顧四方。",
    "start": 204.07,
    "end": 206.88
  },
  {
    "id": 73,
    "text": "若見有人至，正視道善來。",
    "start": 206.88,
    "end": 209.51
  },
  {
    "id": 74,
    "text": "為察道途險，四處頻觀望；",
    "start": 209.51,
    "end": 212.39
  },
  {
    "id": 75,
    "text": "憩時宜回顧，背面細檢索。",
    "start": 212.39,
    "end": 215.04
  },
  {
    "id": 76,
    "text": "前後視察已，續行或折返。",
    "start": 215.04,
    "end": 218.11
  },
  {
    "id": 77,
    "text": "故於一切時，應視所需行。",
    "start": 218.11,
    "end": 220.77
  },
  {
    "id": 78,
    "text": "欲身知是住，安妥威儀已，",
    "start": 220.77,
    "end": 223.75
  },
  {
    "id": 79,
    "text": "時時應細察：此身云何住？",
    "start": 223.75,
    "end": 226.49
  },
  {
    "id": 80,
    "text": "盡力遍觀察：此若狂象心，",
    "start": 226.49,
    "end": 229.49
  },
  {
    "id": 81,
    "text": "緊繫念法柱，已拴未失否？",
    "start": 229.49,
    "end": 232.33
  },
  {
    "id": 82,
    "text": "精進習定者，剎那勿弛散；",
    "start": 232.33,
    "end": 235.42
  },
  {
    "id": 83,
    "text": "念念恆伺察：吾意何所之？",
    "start": 235.42,
    "end": 237.96
  },
  {
    "id": 84,
    "text": "危難喜慶時，心散亦應安；",
    "start": 237.96,
    "end": 241.06
  },
  {
    "id": 85,
    "text": "經說行施時，可捨微細戒。",
    "start": 241.06,
    "end": 243.84
  },
  {
    "id": 86,
    "text": "思已欲為時，莫更思他事；",
    "start": 243.84,
    "end": 247.15
  },
  {
    "id": 87,
    "text": "心志應專一，且先成辦彼。",
    "start": 247.15,
    "end": 249.49
  },
  {
    "id": 88,
    "text": "如是事皆成，否則俱不成。",
    "start": 249.49,
    "end": 252.29
  },
  {
    "id": 89,
    "text": "隨惑不正知，由是不增盛。",
    "start": 252.29,
    "end": 255.1
  },
  {
    "id": 90,
    "text": "無義眾閒談，諸多賞心劇，",
    "start": 255.1,
    "end": 258.34
  },
  {
    "id": 91,
    "text": "臨彼境界時，當斷意貪著。",
    "start": 258.34,
    "end": 261.19
  },
  {
    "id": 92,
    "text": "無義掘挖割，於地繪圖時，",
    "start": 261.19,
    "end": 263.83
  },
  {
    "id": 93,
    "text": "當憶如來教，懼罪捨彼行。",
    "start": 263.83,
    "end": 266.41
  },
  {
    "id": 94,
    "text": "若身欲移動，或口欲出言，",
    "start": 266.41,
    "end": 270.0
  },
  {
    "id": 95,
    "text": "應先觀自心，安穩如理行。",
    "start": 270.0,
    "end": 272.26
  },
  {
    "id": 96,
    "text": "吾意正生貪，或欲瞋恨時，",
    "start": 272.26,
    "end": 275.04
  },
  {
    "id": 97,
    "text": "言行應暫止，如樹安穩住。",
    "start": 275.04,
    "end": 277.9
  },
  {
    "id": 98,
    "text": "掉舉與藐視，傲慢或驕矜，",
    "start": 277.9,
    "end": 280.97
  },
  {
    "id": 99,
    "text": "或欲揭人短，或思偽與詐，",
    "start": 280.97,
    "end": 283.56
  },
  {
    "id": 100,
    "text": "或思勤自讚，或欲詆毀他，",
    "start": 283.56,
    "end": 286.0
  },
  {
    "id": 101,
    "text": "粗言興諍鬥，如樹應安住。",
    "start": 286.0,
    "end": 289.02
  },
  {
    "id": 102,
    "text": "或思名利敬，若欲差僕役，",
    "start": 289.02,
    "end": 292.46
  },
  {
    "id": 103,
    "text": "若欲人侍奉，如樹應安住。",
    "start": 292.46,
    "end": 295.18
  },
  {
    "id": 104,
    "text": "欲削棄他利，或欲圖己利，",
    "start": 295.18,
    "end": 298.05
  },
  {
    "id": 105,
    "text": "因是欲語時，如樹應安住。",
    "start": 298.05,
    "end": 301.0
  },
  {
    "id": 106,
    "text": "不耐懶與懼，無恥言無義，",
    "start": 301.0,
    "end": 304.2
  },
  {
    "id": 107,
    "text": "親友愛若生，如樹應安住。",
    "start": 304.2,
    "end": 306.91
  },
  {
    "id": 108,
    "text": "應觀此染污、好行無義心；",
    "start": 306.91,
    "end": 309.82
  },
  {
    "id": 109,
    "text": "知已當對治，堅持守此意。",
    "start": 309.82,
    "end": 312.7
  },
  {
    "id": 110,
    "text": "深信極肯定、堅穩恭有禮、",
    "start": 312.7,
    "end": 315.94
  },
  {
    "id": 111,
    "text": "知慚畏因果、寂靜勤予樂。",
    "start": 315.94,
    "end": 318.6
  },
  {
    "id": 112,
    "text": "愚稚意不合，心且莫生厭；",
    "start": 318.6,
    "end": 321.1
  },
  {
    "id": 113,
    "text": "彼乃惑所生，思已應懷慈。",
    "start": 321.1,
    "end": 324.05
  },
  {
    "id": 114,
    "text": "為自及有情，利行不犯罪，",
    "start": 324.05,
    "end": 326.95
  },
  {
    "id": 115,
    "text": "更以幻化觀，恆常守此意。",
    "start": 326.95,
    "end": 329.69
  },
  {
    "id": 116,
    "text": "吾當再三思：歷劫得暇滿，",
    "start": 329.69,
    "end": 332.28
  },
  {
    "id": 117,
    "text": "故應持此心，不動如須彌。",
    "start": 332.28,
    "end": 335.18
  },
  {
    "id": 118,
    "text": "禿鷹貪食肉，爭奪扯我屍；",
    "start": 335.18,
    "end": 338.28
  },
  {
    "id": 119,
    "text": "若汝不經意，云何今愛惜？",
    "start": 338.28,
    "end": 341.09
  },
  {
    "id": 120,
    "text": "意汝於此身，何故執且護？",
    "start": 341.09,
    "end": 343.8
  },
  {
    "id": 121,
    "text": "汝彼既各別，於汝何所需？",
    "start": 343.8,
    "end": 346.2
  },
  {
    "id": 122,
    "text": "癡意汝云何，不護淨木像？",
    "start": 346.2,
    "end": 349.08
  },
  {
    "id": 123,
    "text": "何苦勤守護，腐朽臭皮囊？",
    "start": 349.08,
    "end": 351.91
  },
  {
    "id": 124,
    "text": "首當以意觀，析出表皮層，",
    "start": 351.91,
    "end": 354.42
  },
  {
    "id": 125,
    "text": "次以智慧劍，剔肉離身骨。",
    "start": 354.42,
    "end": 357.14
  },
  {
    "id": 126,
    "text": "復解諸骨骼，審觀至於髓；",
    "start": 357.14,
    "end": 360.29
  },
  {
    "id": 127,
    "text": "當自如是究：何處見精妙？",
    "start": 360.29,
    "end": 363.05
  },
  {
    "id": 128,
    "text": "如是勤尋覓，若未見精妙，",
    "start": 363.05,
    "end": 365.5
  },
  {
    "id": 129,
    "text": "何故猶貪著、愛護此垢身？",
    "start": 365.5,
    "end": 368.4
  },
  {
    "id": 130,
    "text": "若垢不堪食，身血不宜飲，",
    "start": 368.4,
    "end": 371.35
  },
  {
    "id": 131,
    "text": "腸胃不適吮，身復何所需？",
    "start": 371.35,
    "end": 374.35
  },
  {
    "id": 132,
    "text": "貪身唯一因，為護狐鷲食；",
    "start": 374.35,
    "end": 377.14
  },
  {
    "id": 133,
    "text": "故應惜此身，獨為修諸善。",
    "start": 377.14,
    "end": 380.15
  },
  {
    "id": 134,
    "text": "縱汝護如此，死神不留情，",
    "start": 380.15,
    "end": 383.18
  },
  {
    "id": 135,
    "text": "奪已施鷲狗，屆時復何如？",
    "start": 383.18,
    "end": 386.02
  },
  {
    "id": 136,
    "text": "若僕不堪使，主不與衣食；",
    "start": 386.02,
    "end": 388.75
  },
  {
    "id": 137,
    "text": "養身而它去，為何善養護？",
    "start": 388.75,
    "end": 391.7
  },
  {
    "id": 138,
    "text": "既酬彼薪資，當令辦吾利；",
    "start": 391.7,
    "end": 394.85
  },
  {
    "id": 139,
    "text": "無益則於彼，一切不應與。",
    "start": 394.85,
    "end": 397.32
  },
  {
    "id": 140,
    "text": "念身如舟楫，唯充去來依；",
    "start": 397.32,
    "end": 400.3
  },
  {
    "id": 141,
    "text": "為辦有情利，修成如意身。",
    "start": 400.3,
    "end": 403.27
  },
  {
    "id": 142,
    "text": "自主己身心，恆常露笑顏，",
    "start": 403.27,
    "end": 406.49
  },
  {
    "id": 143,
    "text": "平息怒紋眉，語實友眾生。",
    "start": 406.49,
    "end": 409.1
  },
  {
    "id": 144,
    "text": "移座勿隨意，至發大音聲，",
    "start": 409.1,
    "end": 412.15
  },
  {
    "id": 145,
    "text": "開門勿粗暴，常喜寂靜行。",
    "start": 412.15,
    "end": 414.94
  },
  {
    "id": 146,
    "text": "水鷗貓盜賊，無聲行悄捷，",
    "start": 414.94,
    "end": 417.9
  },
  {
    "id": 147,
    "text": "故成所欲事，佛諭如是行。",
    "start": 417.9,
    "end": 420.7
  },
  {
    "id": 148,
    "text": "宜善受人勸，恭敬且頂戴，",
    "start": 420.7,
    "end": 423.43
  },
  {
    "id": 149,
    "text": "不請饒益語，恆為眾人徒。",
    "start": 423.43,
    "end": 426.19
  },
  {
    "id": 150,
    "text": "一切妙雋語，皆讚為善說；",
    "start": 426.19,
    "end": 429.17
  },
  {
    "id": 151,
    "text": "見人行福善，歡喜生讚嘆。",
    "start": 429.17,
    "end": 431.85
  },
  {
    "id": 152,
    "text": "暗稱他人功，隨和他人德；",
    "start": 431.85,
    "end": 434.86
  },
  {
    "id": 153,
    "text": "聞人稱己德，應忖自有無。",
    "start": 434.86,
    "end": 437.52
  },
  {
    "id": 154,
    "text": "一切行為喜，此喜價難沽，",
    "start": 437.52,
    "end": 440.81
  },
  {
    "id": 155,
    "text": "故當依他德，安享隨喜樂。",
    "start": 440.81,
    "end": 443.3
  },
  {
    "id": 156,
    "text": "如是今無損，來世樂亦多；",
    "start": 443.3,
    "end": 446.11
  },
  {
    "id": 157,
    "text": "反之因嫉苦，後世苦更增。",
    "start": 446.11,
    "end": 449.04
  },
  {
    "id": 158,
    "text": "出言當稱意，義明語相關，",
    "start": 449.04,
    "end": 452.18
  },
  {
    "id": 159,
    "text": "悅意離貪瞋，柔和調適中。",
    "start": 452.18,
    "end": 455.4
  },
  {
    "id": 160,
    "text": "眼見有情時，誠慈而視之；",
    "start": 455.4,
    "end": 458.59
  },
  {
    "id": 161,
    "text": "念我依於彼，乃能成佛道。",
    "start": 458.59,
    "end": 461.09
  },
  {
    "id": 162,
    "text": "熱衷恆修善，或勤興對治。",
    "start": 461.09,
    "end": 464.47
  },
  {
    "id": 163,
    "text": "施恩悲福田，成就大福善。",
    "start": 464.47,
    "end": 467.18
  },
  {
    "id": 164,
    "text": "善巧具信已，即當常修善；",
    "start": 467.18,
    "end": 469.85
  },
  {
    "id": 165,
    "text": "眾善己應為，誰亦不仰仗。",
    "start": 469.85,
    "end": 472.6
  },
  {
    "id": 166,
    "text": "施等波羅蜜，層層漸昇進；",
    "start": 472.6,
    "end": 475.48
  },
  {
    "id": 167,
    "text": "勿因小失大，大處思利他。",
    "start": 475.48,
    "end": 478.44
  },
  {
    "id": 168,
    "text": "前理既已明，應勤饒益他。",
    "start": 478.44,
    "end": 481.32
  },
  {
    "id": 169,
    "text": "慧遠具悲者，佛亦開諸遮。",
    "start": 481.32,
    "end": 484.39
  },
  {
    "id": 170,
    "text": "食當與墮者、無怙住戒者，",
    "start": 484.39,
    "end": 487.05
  },
  {
    "id": 171,
    "text": "己食唯適量；三衣餘盡施。",
    "start": 487.05,
    "end": 490.15
  },
  {
    "id": 172,
    "text": "修行正法身，莫為小故傷；",
    "start": 490.15,
    "end": 493.45
  },
  {
    "id": 173,
    "text": "行此眾生願，迅速得圓滿。",
    "start": 493.45,
    "end": 496.39
  },
  {
    "id": 174,
    "text": "悲願未清淨，不應施此身；",
    "start": 496.39,
    "end": 499.2
  },
  {
    "id": 175,
    "text": "今世或他生，利大乃可捨。",
    "start": 499.2,
    "end": 502.2
  },
  {
    "id": 176,
    "text": "無病而覆頭、纏頭或撐傘、",
    "start": 502.2,
    "end": 504.97
  },
  {
    "id": 177,
    "text": "手持刀兵杖，不敬勿說法。",
    "start": 504.97,
    "end": 507.6
  },
  {
    "id": 178,
    "text": "莫示無伴女。慧淺莫言深。",
    "start": 507.6,
    "end": 510.62
  },
  {
    "id": 179,
    "text": "於諸淺深法，等敬漸修習。",
    "start": 510.62,
    "end": 513.38
  },
  {
    "id": 180,
    "text": "於諸利根器，不應與淺法。",
    "start": 513.38,
    "end": 516.24
  },
  {
    "id": 181,
    "text": "不應捨律行，以咒誑惑人。",
    "start": 516.24,
    "end": 519.1
  },
  {
    "id": 182,
    "text": "牙木與唾涕，棄時應掩蔽；",
    "start": 519.1,
    "end": 522.05
  },
  {
    "id": 183,
    "text": "用水及淨地，不應棄屎溺。",
    "start": 522.05,
    "end": 524.88
  },
  {
    "id": 184,
    "text": "食時莫滿口、出聲與咧嘴。",
    "start": 524.88,
    "end": 527.33
  },
  {
    "id": 185,
    "text": "坐時勿伸足，雙手莫揉搓。",
    "start": 527.33,
    "end": 530.57
  },
  {
    "id": 186,
    "text": "車床幽隱處，莫會他人婦。",
    "start": 530.57,
    "end": 532.98
  },
  {
    "id": 187,
    "text": "世間所不信，隨俗避譏嫌。",
    "start": 532.98,
    "end": 536.26
  },
  {
    "id": 188,
    "text": "單指莫示意，心當懷恭敬，",
    "start": 536.26,
    "end": 539.16
  },
  {
    "id": 189,
    "text": "平伸右手掌；示路亦如是。",
    "start": 539.16,
    "end": 541.69
  },
  {
    "id": 190,
    "text": "肩臂莫揮擺，示意以微動、",
    "start": 541.69,
    "end": 544.38
  },
  {
    "id": 191,
    "text": "出聲及彈指，否則易失儀。",
    "start": 544.38,
    "end": 547.27
  },
  {
    "id": 192,
    "text": "睡如佛涅槃，應朝欲方臥；",
    "start": 547.27,
    "end": 550.36
  },
  {
    "id": 193,
    "text": "正知並決志：覺已速起身。",
    "start": 550.36,
    "end": 553.39
  },
  {
    "id": 194,
    "text": "菩薩諸行儀，經說無有盡，",
    "start": 553.39,
    "end": 556.34
  },
  {
    "id": 195,
    "text": "然當盡己力，修持淨心行。",
    "start": 556.34,
    "end": 559.37
  },
  {
    "id": 196,
    "text": "晝夜當各三，誦讀三聚經，",
    "start": 559.37,
    "end": 562.34
  },
  {
    "id": 197,
    "text": "依佛菩提心，悔除墮罪餘。",
    "start": 562.34,
    "end": 565.32
  },
  {
    "id": 198,
    "text": "為自或為他，何時修何行，",
    "start": 565.32,
    "end": 567.89
  },
  {
    "id": 199,
    "text": "佛說諸學處，皆當勤修習。",
    "start": 567.89,
    "end": 571.17
  },
  {
    "id": 200,
    "text": "佛子不需學，畢竟皆無有。",
    "start": 571.17,
    "end": 573.96
  },
  {
    "id": 201,
    "text": "善學若如是，福德焉不至？",
    "start": 573.96,
    "end": 576.98
  },
  {
    "id": 202,
    "text": "直接或間接，所行唯利他；",
    "start": 576.98,
    "end": 579.84
  },
  {
    "id": 203,
    "text": "但為有情利，迴向大菩提。",
    "start": 579.84,
    "end": 582.89
  },
  {
    "id": 204,
    "text": "捨命亦不離，善巧大乘義，",
    "start": 582.89,
    "end": 585.64
  },
  {
    "id": 205,
    "text": "安住淨律儀，珍貴善知識。",
    "start": 585.64,
    "end": 588.6
  },
  {
    "id": 206,
    "text": "應如吉祥生，修學侍師規。",
    "start": 588.6,
    "end": 591.57
  },
  {
    "id": 207,
    "text": "此及餘學處，閱經即能知。",
    "start": 591.57,
    "end": 594.38
  },
  {
    "id": 208,
    "text": "經中學處廣，故應閱經藏。",
    "start": 594.38,
    "end": 597.29
  },
  {
    "id": 209,
    "text": "首當先閱覽，尊聖虛空藏；",
    "start": 597.29,
    "end": 600.17
  },
  {
    "id": 210,
    "text": "亦當勤閱讀，學處眾集要，",
    "start": 600.17,
    "end": 603.43
  },
  {
    "id": 211,
    "text": "佛子恆修處，學集廣說故。",
    "start": 603.43,
    "end": 606.41
  },
  {
    "id": 212,
    "text": "或暫閱精簡，一切經集要。",
    "start": 606.41,
    "end": 609.34
  },
  {
    "id": 213,
    "text": "亦當偶披閱，龍樹二論典。",
    "start": 609.34,
    "end": 612.02
  },
  {
    "id": 214,
    "text": "經論所未遮，皆當勤修學。",
    "start": 612.02,
    "end": 615.16
  },
  {
    "id": 215,
    "text": "為護世人心，知已即當行。",
    "start": 615.16,
    "end": 617.99
  },
  {
    "id": 216,
    "text": "再三宜深觀，身心諸情狀。",
    "start": 617.99,
    "end": 620.76
  },
  {
    "id": 217,
    "text": "僅此簡言之，即護正知義。",
    "start": 620.76,
    "end": 623.92
  },
  {
    "id": 218,
    "text": "法應躬謹行，徒說豈獲益？",
    "start": 623.92,
    "end": 626.62
  },
  {
    "id": 219,
    "text": "唯閱療病方，疾患云何癒？",
    "start": 626.62,
    "end": 630.05
  }
]