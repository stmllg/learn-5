[
  {
    "id": 1,
    "text": "善慧教法廣弘文",
    "start": 2.0,
    "end": 4.22
  },
  {
    "id": 2,
    "text": "雖為出生諸佛之父親",
    "start": 4.22,
    "end": 7.81
  },
  {
    "id": 3,
    "text": "現菩薩相而於無邊土",
    "start": 7.81,
    "end": 9.91
  },
  {
    "id": 4,
    "text": "執持佛法發心諦實力",
    "start": 9.91,
    "end": 11.95
  },
  {
    "id": 5,
    "text": "祈願善慧勝者教廣弘",
    "start": 11.95,
    "end": 14.26
  },
  {
    "id": 6,
    "text": "昔於王頂如來座前方",
    "start": 14.26,
    "end": 16.61
  },
  {
    "id": 7,
    "text": "發誓願故諸佛及菩薩",
    "start": 16.61,
    "end": 18.89
  },
  {
    "id": 8,
    "text": "讚為大志以此諦實力",
    "start": 18.89,
    "end": 21.26
  },
  {
    "id": 9,
    "text": "祈願善慧勝者教廣弘",
    "start": 21.26,
    "end": 23.47
  },
  {
    "id": 10,
    "text": "為宏清淨見行之傳承",
    "start": 23.47,
    "end": 25.7
  },
  {
    "id": 11,
    "text": "於能仁前供養水晶鬘",
    "start": 25.7,
    "end": 28.08
  },
  {
    "id": 12,
    "text": "賜與法螺授記諦實力",
    "start": 28.08,
    "end": 30.26
  },
  {
    "id": 13,
    "text": "祈願善慧勝者教廣弘",
    "start": 30.26,
    "end": 32.66
  },
  {
    "id": 14,
    "text": "正見清淨遠離斷常邊",
    "start": 32.66,
    "end": 34.75
  },
  {
    "id": 15,
    "text": "修持清淨破除沉掉闇",
    "start": 34.75,
    "end": 37.03
  },
  {
    "id": 16,
    "text": "行持清淨遵佛教誡行",
    "start": 37.03,
    "end": 39.48
  },
  {
    "id": 17,
    "text": "祈願善慧勝者教廣弘",
    "start": 39.48,
    "end": 41.47
  },
  {
    "id": 18,
    "text": "多聞廣博領解故善巧",
    "start": 41.47,
    "end": 43.96
  },
  {
    "id": 19,
    "text": "聞義如實合心故戒嚴",
    "start": 43.96,
    "end": 46.1
  },
  {
    "id": 20,
    "text": "回向教法眾生故賢善",
    "start": 46.1,
    "end": 48.31
  },
  {
    "id": 21,
    "text": "祈願善慧勝者教廣弘",
    "start": 48.31,
    "end": 50.64
  },
  {
    "id": 22,
    "text": "了不了義至言無相違",
    "start": 50.64,
    "end": 52.87
  },
  {
    "id": 23,
    "text": "為一士夫行持之教授",
    "start": 52.87,
    "end": 55.01
  },
  {
    "id": 24,
    "text": "獲定解故遮一切惡行",
    "start": 55.01,
    "end": 57.24
  },
  {
    "id": 25,
    "text": "祈願善慧勝者教廣弘",
    "start": 57.24,
    "end": 59.53
  },
  {
    "id": 26,
    "text": "經教三藏講說與聽聞",
    "start": 59.53,
    "end": 61.96
  },
  {
    "id": 27,
    "text": "證量教法三學之修持",
    "start": 61.96,
    "end": 64.1
  },
  {
    "id": 28,
    "text": "善巧成就懿範極稀有",
    "start": 64.1,
    "end": 66.62
  },
  {
    "id": 29,
    "text": "祈願善慧勝者教廣弘",
    "start": 66.62,
    "end": 68.86
  },
  {
    "id": 30,
    "text": "外現聲聞行儀靜調伏",
    "start": 68.86,
    "end": 71.04
  },
  {
    "id": 31,
    "text": "內具二次瑜伽之定見",
    "start": 71.04,
    "end": 73.39
  },
  {
    "id": 32,
    "text": "顯密善道無違之助伴",
    "start": 73.39,
    "end": 75.67
  },
  {
    "id": 33,
    "text": "祈願善慧勝者教廣弘",
    "start": 75.67,
    "end": 77.88
  },
  {
    "id": 34,
    "text": "結合因乘宣說之空性",
    "start": 77.88,
    "end": 80.16
  },
  {
    "id": 35,
    "text": "果位方便成辦之大樂",
    "start": 80.16,
    "end": 82.39
  },
  {
    "id": 36,
    "text": "八萬法蘊心藏之心髓",
    "start": 82.39,
    "end": 84.74
  },
  {
    "id": 37,
    "text": "祈願善慧勝者教廣弘",
    "start": 84.74,
    "end": 87.16
  },
  {
    "id": 38,
    "text": "三士道次護法之主尊",
    "start": 87.16,
    "end": 89.28
  },
  {
    "id": 39,
    "text": "速救怙主多聞閻魔等",
    "start": 89.28,
    "end": 91.56
  },
  {
    "id": 40,
    "text": "具誓護法海會威神力",
    "start": 91.56,
    "end": 93.84
  },
  {
    "id": 41,
    "text": "祈願善慧勝者教廣弘",
    "start": 93.84,
    "end": 96.11
  },
  {
    "id": 42,
    "text": "總之具德上師壽堅固",
    "start": 96.11,
    "end": 98.38
  },
  {
    "id": 43,
    "text": "賢正持教善士遍人間",
    "start": 98.38,
    "end": 100.68
  },
  {
    "id": 44,
    "text": "教法施主勢力得增盛",
    "start": 100.68,
    "end": 103.06
  },
  {
    "id": 45,
    "text": "祈願善慧勝者教廣弘",
    "start": 103.06,
    "end": 106.06
  }
]