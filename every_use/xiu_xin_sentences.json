[
  {
    "id": 1,
    "text": "修心八偈",
    "start": 2.0,
    "end": 3.7
  },
  {
    "id": 2,
    "text": "我於虛空如母眾",
    "start": 3.7,
    "end": 5.63
  },
  {
    "id": 3,
    "text": "視之猶勝如意寶",
    "start": 5.63,
    "end": 7.57
  },
  {
    "id": 4,
    "text": "依彼能成究竟利",
    "start": 7.57,
    "end": 9.53
  },
  {
    "id": 5,
    "text": "恆常心懷珍愛惜",
    "start": 9.53,
    "end": 11.58
  },
  {
    "id": 6,
    "text": "任與誰等會聚時",
    "start": 11.58,
    "end": 13.55
  },
  {
    "id": 7,
    "text": "思己較諸他人卑",
    "start": 13.55,
    "end": 15.6
  },
  {
    "id": 8,
    "text": "從心深處視眾生",
    "start": 15.6,
    "end": 17.64
  },
  {
    "id": 9,
    "text": "恆常尊他為最勝",
    "start": 17.64,
    "end": 19.65
  },
  {
    "id": 10,
    "text": "一切威儀觀自心",
    "start": 19.65,
    "end": 21.73
  },
  {
    "id": 11,
    "text": "微惑尋生即覺察",
    "start": 21.73,
    "end": 23.73
  },
  {
    "id": 12,
    "text": "惑仇唯令自他損",
    "start": 23.73,
    "end": 26.17
  },
  {
    "id": 13,
    "text": "願速喝斥令消除",
    "start": 26.17,
    "end": 27.9
  },
  {
    "id": 14,
    "text": "秉性邪惡諸有情",
    "start": 27.9,
    "end": 29.95
  },
  {
    "id": 15,
    "text": "思彼猛烈罪苦煎",
    "start": 29.95,
    "end": 31.94
  },
  {
    "id": 16,
    "text": "對境如獲珍寶藏",
    "start": 31.94,
    "end": 34.26
  },
  {
    "id": 17,
    "text": "難值修悲願珍惜",
    "start": 34.26,
    "end": 36.1
  },
  {
    "id": 18,
    "text": "彼雖橫生嫉妒心",
    "start": 36.1,
    "end": 38.25
  },
  {
    "id": 19,
    "text": "非理辱罵謗我等",
    "start": 38.25,
    "end": 40.2
  },
  {
    "id": 20,
    "text": "盡其損惱我取受",
    "start": 40.2,
    "end": 42.53
  },
  {
    "id": 21,
    "text": "願將利樂奉獻他",
    "start": 42.53,
    "end": 44.46
  },
  {
    "id": 22,
    "text": "我曾於彼利樂施",
    "start": 44.46,
    "end": 46.3
  },
  {
    "id": 23,
    "text": "並與深心寄厚望",
    "start": 46.3,
    "end": 48.34
  },
  {
    "id": 24,
    "text": "彼卻非理妄加害",
    "start": 48.34,
    "end": 50.45
  },
  {
    "id": 25,
    "text": "願仍視為勝導師",
    "start": 50.45,
    "end": 52.35
  },
  {
    "id": 26,
    "text": "直接間接諸利樂",
    "start": 52.35,
    "end": 54.55
  },
  {
    "id": 27,
    "text": "願集奉獻如母眾",
    "start": 54.55,
    "end": 56.85
  },
  {
    "id": 28,
    "text": "如母有情眾苦迫",
    "start": 56.85,
    "end": 58.97
  },
  {
    "id": 29,
    "text": "我願暗中盡取受",
    "start": 58.97,
    "end": 60.74
  },
  {
    "id": 30,
    "text": "願將所修一切善",
    "start": 60.74,
    "end": 63.0
  },
  {
    "id": 31,
    "text": "莫為八法所垢染",
    "start": 63.0,
    "end": 64.8
  },
  {
    "id": 32,
    "text": "深觀諸法皆如幻",
    "start": 64.8,
    "end": 67.16
  },
  {
    "id": 33,
    "text": "離執離繫得解脫",
    "start": 67.16,
    "end": 69.35
  }
]