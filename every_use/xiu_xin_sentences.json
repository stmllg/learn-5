[
  {
    "id": 1,
    "text": "修心八偈",
    "start": 2.0,
    "end": 3.58
  },
  {
    "id": 2,
    "text": "我於虛空如母眾",
    "start": 3.58,
    "end": 5.66
  },
  {
    "id": 3,
    "text": "視之猶勝如意寶",
    "start": 5.66,
    "end": 7.65
  },
  {
    "id": 4,
    "text": "依彼能成究竟利",
    "start": 7.65,
    "end": 9.6
  },
  {
    "id": 5,
    "text": "恆常心懷珍愛惜",
    "start": 9.6,
    "end": 11.57
  },
  {
    "id": 6,
    "text": "任與誰等會聚時",
    "start": 11.57,
    "end": 13.8
  },
  {
    "id": 7,
    "text": "思己較諸他人卑",
    "start": 13.8,
    "end": 15.86
  },
  {
    "id": 8,
    "text": "從心深處視眾生",
    "start": 15.86,
    "end": 17.88
  },
  {
    "id": 9,
    "text": "恆常尊他為最勝",
    "start": 17.88,
    "end": 19.73
  },
  {
    "id": 10,
    "text": "一切威儀觀自心",
    "start": 19.73,
    "end": 21.84
  },
  {
    "id": 11,
    "text": "微惑尋生即覺察",
    "start": 21.84,
    "end": 23.69
  },
  {
    "id": 12,
    "text": "惑仇唯令自他損",
    "start": 23.69,
    "end": 25.97
  },
  {
    "id": 13,
    "text": "願速喝斥令消除",
    "start": 25.97,
    "end": 28.15
  },
  {
    "id": 14,
    "text": "秉性邪惡諸有情",
    "start": 28.15,
    "end": 30.14
  },
  {
    "id": 15,
    "text": "思彼猛烈罪苦煎",
    "start": 30.14,
    "end": 32.16
  },
  {
    "id": 16,
    "text": "對境如獲珍寶藏",
    "start": 32.16,
    "end": 34.27
  },
  {
    "id": 17,
    "text": "難值修悲願珍惜",
    "start": 34.27,
    "end": 36.31
  },
  {
    "id": 18,
    "text": "彼雖橫生嫉妒心",
    "start": 36.31,
    "end": 38.47
  },
  {
    "id": 19,
    "text": "非理辱罵謗我等",
    "start": 38.47,
    "end": 40.18
  },
  {
    "id": 20,
    "text": "盡其損惱我取受",
    "start": 40.18,
    "end": 42.41
  },
  {
    "id": 21,
    "text": "願將利樂奉獻他",
    "start": 42.41,
    "end": 44.59
  },
  {
    "id": 22,
    "text": "我曾於彼利樂施",
    "start": 44.59,
    "end": 46.73
  },
  {
    "id": 23,
    "text": "並與深心寄厚望",
    "start": 46.73,
    "end": 48.58
  },
  {
    "id": 24,
    "text": "彼卻非理妄加害",
    "start": 48.58,
    "end": 50.66
  },
  {
    "id": 25,
    "text": "願仍視為勝導師",
    "start": 50.66,
    "end": 52.56
  },
  {
    "id": 26,
    "text": "直接間接諸利樂",
    "start": 52.56,
    "end": 54.77
  },
  {
    "id": 27,
    "text": "願集奉獻如母眾",
    "start": 54.77,
    "end": 56.75
  },
  {
    "id": 28,
    "text": "如母有情眾苦迫",
    "start": 56.75,
    "end": 59.02
  },
  {
    "id": 29,
    "text": "我願暗中盡取受",
    "start": 59.02,
    "end": 60.86
  },
  {
    "id": 30,
    "text": "願將所修一切善",
    "start": 60.86,
    "end": 63.0
  },
  {
    "id": 31,
    "text": "莫為八法所垢染",
    "start": 63.0,
    "end": 64.87
  },
  {
    "id": 32,
    "text": "深觀諸法皆如幻",
    "start": 64.87,
    "end": 67.07
  },
  {
    "id": 33,
    "text": "離執離繫得解脫",
    "start": 67.07,
    "end": 69.46
  }
]