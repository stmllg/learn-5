[
  {"id": 1, "text": "文殊戰", "start": 2.02, "end": 3.03},
  {"id": 2, "text": "南摩歸一金剛上師", "start": 4.0, "end": 6.02},
  {"id": 3, "text": "文殊施力菩薩", "start": 6.02, "end": 8.02},
  {"id": 4, "text": "誰知智慧離惡藏雲", "start": 8.02, "end": 10.02},
  {"id": 5, "text": "猶如近日即明朗", "start": 10.02, "end": 12.03},
  {"id": 6, "text": "所有諸意如時關顧", "start": 12.03, "end": 15.0},
  {"id": 7, "text": "胸中指齒般惹寒", "start": 15.0, "end": 17.01},
  {"id": 8, "text": "諸有於此生死牢獄", "start": 17.01, "end": 19.02},
  {"id": 9, "text": "無名暗負苦所逼", "start": 19.02, "end": 21.01},
  {"id": 10, "text": "眾生海中悲同一職", "start": 21.01, "end": 23.01},
  {"id": 11, "text": "聚足六時運陰雨", "start": 23.01, "end": 25.02},
  {"id": 12, "text": "如大雷陣煩惱睡起", "start": 25.02, "end": 27.02},
  {"id": 13, "text": "夜知鐵所未解脫", "start": 27.02, "end": 29.03},
  {"id": 14, "text": "無名暗處苦思苗芽", "start": 29.03, "end": 31.03},
  {"id": 15, "text": "进阶为断挥宝剑", "start": 31.03, "end": 33.03},
  {"id": 16, "text": "从本精进就尽实地", "start": 33.03, "end": 36.0},
  {"id": 17, "text": "功德深远佛子最圣体", "start": 36.0, "end": 38.0},
  {"id": 18, "text": "百依十二向好庄严", "start": 38.0, "end": 40.01},
  {"id": 19, "text": "除我心安尽礼妙吉祥", "start": 40.01, "end": 43.0},
  {"id": 20, "text": "奥阿扎巴扎那底", "start": 43.0, "end": 44.02},
  {"id": 21, "text": "大悲尊以极片自光明", "start": 44.02, "end": 47.01},
  {"id": 22, "text": "尽处我心于痴诸黑暗", "start": 47.01, "end": 49.02},
  {"id": 23, "text": "迹经极论教典皆正德", "start": 49.02, "end": 52.0},
  {"id": 24, "text": "愿是智慧便才显显现", "start": 52.0, "end": 54.01},
  {"id": 25, "text": "祈求增长文师修慧能", "start": 54.01, "end": 56.03},
  {"id": 26, "text": "祈求增长讲论助智慧", "start": 56.03, "end": 59.01},
  {"id": 27, "text": "祈求事与共不共西地", "start": 59.01, "end": 61.02},
  {"id": 28, "text": "愿述如尊成就其加持", "start": 61.02, "end": 64.01},
  {"id": 29, "text": "祈求任运献决至圣乐", "start": 64.01, "end": 66.02},
  {"id": 30, "text": "祈求速消除颠倒邪志", "start": 66.02, "end": 69.0},
  {"id": 31, "text": "祈求尽断身心疑或往", "start": 69.0, "end": 71.02},
  {"id": 32, "text": "愿述如尊成就其加持", "start": 71.02, "end": 74.01}
]