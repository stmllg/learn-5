[
  {
    "id": 1,
    "text": "文殊讚",
    "start": 2.0,
    "end": 3.83
  },
  {
    "id": 2,
    "text": "南無皈依金剛上師",
    "start": 3.83,
    "end": 6.78
  },
  {
    "id": 3,
    "text": "文殊師利菩薩",
    "start": 6.78,
    "end": 8.4
  },
  {
    "id": 4,
    "text": "誰之智慧離二障雲",
    "start": 8.4,
    "end": 10.63
  },
  {
    "id": 5,
    "text": "猶如淨日極明朗",
    "start": 10.63,
    "end": 12.67
  },
  {
    "id": 6,
    "text": "所有諸義如實觀故",
    "start": 12.67,
    "end": 15.03
  },
  {
    "id": 7,
    "text": "胸中執持般若函",
    "start": 15.03,
    "end": 17.2
  },
  {
    "id": 8,
    "text": "諸有於此生死牢獄",
    "start": 17.2,
    "end": 19.4
  },
  {
    "id": 9,
    "text": "無明闇覆苦所逼",
    "start": 19.4,
    "end": 21.33
  },
  {
    "id": 10,
    "text": "眾生海中悲同一子",
    "start": 21.33,
    "end": 23.43
  },
  {
    "id": 11,
    "text": "具足六十韻音語",
    "start": 23.43,
    "end": 25.39
  },
  {
    "id": 12,
    "text": "如大雷震煩惱睡起",
    "start": 25.39,
    "end": 27.67
  },
  {
    "id": 13,
    "text": "業之鐵索為解脫",
    "start": 27.67,
    "end": 29.63
  },
  {
    "id": 14,
    "text": "無明闇除苦之苗芽",
    "start": 29.63,
    "end": 31.94
  },
  {
    "id": 15,
    "text": "盡皆為斷揮寶劍",
    "start": 31.94,
    "end": 34.23
  },
  {
    "id": 16,
    "text": "從本清淨究竟十地",
    "start": 34.23,
    "end": 36.16
  },
  {
    "id": 17,
    "text": "功德身圓佛子最勝體",
    "start": 36.16,
    "end": 38.08
  },
  {
    "id": 18,
    "text": "百一十二相好莊嚴",
    "start": 38.08,
    "end": 40.37
  },
  {
    "id": 19,
    "text": "除我心闇敬禮妙吉祥",
    "start": 40.37,
    "end": 43.33
  },
  {
    "id": 20,
    "text": "嗡阿惹巴雜那帝",
    "start": 43.33,
    "end": 45.18
  },
  {
    "id": 21,
    "text": "大悲尊以極遍智光明",
    "start": 45.18,
    "end": 47.27
  },
  {
    "id": 22,
    "text": "盡除我心愚癡諸黑暗",
    "start": 47.27,
    "end": 49.63
  },
  {
    "id": 23,
    "text": "契經及論教典皆證得",
    "start": 49.63,
    "end": 51.97
  },
  {
    "id": 24,
    "text": "願賜智慧辯才咸顯現",
    "start": 51.97,
    "end": 54.31
  },
  {
    "id": 25,
    "text": "祈求增長聞思修慧能",
    "start": 54.31,
    "end": 56.83
  },
  {
    "id": 26,
    "text": "祈求增長講論著智慧",
    "start": 56.83,
    "end": 59.27
  },
  {
    "id": 27,
    "text": "祈求賜予共不共悉地",
    "start": 59.27,
    "end": 61.77
  },
  {
    "id": 28,
    "text": "願速如尊成就祈加持",
    "start": 61.77,
    "end": 64.17
  },
  {
    "id": 29,
    "text": "祈求任運現覺智勝樂",
    "start": 64.17,
    "end": 66.64
  },
  {
    "id": 30,
    "text": "祈求速消除顛倒邪執",
    "start": 66.64,
    "end": 69.08
  },
  {
    "id": 31,
    "text": "祈求盡斷身心疑惑網",
    "start": 69.08,
    "end": 71.47
  },
  {
    "id": 32,
    "text": "願速如尊成就祈加持",
    "start": 71.47,
    "end": 77.1
  }
]