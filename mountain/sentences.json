[
  { "id": 1, "text": "二勝六莊嚴讚", "start": 4.30, "end": 5.96 },
  { "id": 2, "text": "悲智憶念無量諸有情", "start": 6.61, "end": 8.74 },
  { "id": 3, "text": "三大祇劫成就二資糧", "start": 8.99, "end": 11.18 },
  { "id": 4, "text": "五濁娑婆無上功德田", "start": 11.48, "end": 13.76 },
  { "id": 5, "text": "釋迦如來尊足下頂禮", "start": 13.91, "end": 16.22 },
  { "id": 6, "text": "般若空慧如實善觀照", "start": 16.82, "end": 19.02 },
  { "id": 7, "text": "勤奮精進榮獲妙吉祥", "start": 19.22, "end": 21.52 },
  { "id": 8, "text": "能仁第二名聞普世間", "start": 21.82, "end": 24.06 },
  { "id": 9, "text": "聖者龍樹尊足下頂禮", "start": 24.26, "end": 26.56 },
  { "id": 10, "text": "龍樹心子圓滿具功德", "start": 26.91, "end": 29.10 },
  { "id": 11, "text": "破邪顯正廣攝有緣人", "start": 29.40, "end": 31.72 },
  { "id": 12, "text": "願離有海普示解脫道", "start": 31.97, "end": 34.32 },
  { "id": 13, "text": "聖者聖天尊足下頂禮", "start": 34.57, "end": 36.94 },
  { "id": 14, "text": "清淨智慧說法昊日月", "start": 37.24, "end": 39.44 },
  { "id": 15, "text": "遍一切處無量最勝智", "start": 39.74, "end": 41.94 },
  { "id": 16, "text": "彰顯聖教如日虛空住", "start": 42.24, "end": 44.42 },
  { "id": 17, "text": "聖者無著尊足下頂禮", "start": 44.67, "end": 46.98 },
  { "id": 18, "text": "九九經函胸中深執持", "start": 47.28, "end": 49.52 },
  { "id": 19, "text": "慧力盈滿郁郁潤法身", "start": 49.72, "end": 51.96 },
  { "id": 20, "text": "智者第二娑婆善稱揚", "start": 52.23, "end": 54.52 },
  { "id": 21, "text": "聖者世親尊足下頂禮", "start": 54.72, "end": 57.20 },
  { "id": 22, "text": "清淨潔白極遍智尊貴", "start": 57.55, "end": 59.82 },
  { "id": 23, "text": "荷擔家業功德煥榮光", "start": 60.02, "end": 62.34 },
  { "id": 24, "text": "金剛焰盡摧稠林邪見", "start": 62.46, "end": 64.88 },
  { "id": 25, "text": "聖者陳那尊足下頂禮", "start": 65.03, end: 67.43 },
  { "id": 26, "text": "論證慧劍外道莫能禦", "start": 67.46, "end": 69.83 },
  { "id": 27, "text": "赫赫聲名威德震三界", "start": 69.93, "end": 72.30 },
  { "id": 28, "text": "法幢殊勝慧日破諸闇", "start": 72.45, "end": 74.81 },
  { "id": 29, "text": "聖者法稱尊足下頂禮", "start": 74.85, "end": 77.23 },
  { "id": 30, "text": "安忍寂靜自居律儀海", "start": 77.26, "end": 79.73 },
  { "id": 31, "text": "十萬戒經蛇冠昱德昭", "start": 79.79, "end": 82.06 },
  { "id": 32, "text": "解脫如意寶飾頂莊嚴", "start": 82.36, "end": 84.60 },
  { "id": 33, "text": "功德釋迦尊足下頂禮", "start": 84.85, "end": 87.02 },
  { "id": 34, "text": "世尊傳承深廣二車軌", "start": 87.32, "end": 89.54 },
  { "id": 35, "text": "福智普顯善道示眾生", "start": 89.84, "end": 92.00 },
  { "id": 36, "text": "皦然世界二勝六莊嚴", "start": 92.25, "end": 94.44 },
  { "id": 37, "text": "一切時中至誠稽首禮", "start": 94.69, "end": 97.12 }
]