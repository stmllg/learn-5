    {"id":29,"text":"我願暗中盡取受","start":58.69,"end":60.79,"unit_uid":"0f3b363b4c72f5e1ca62","role":"body","pdf_page":0,"bbox":[4.327,420.914,71.527,432.914],"glyphs":[{"c":"我","bbox":[4.327,420.914,13.927,432.914]},{"c":"願","bbox":[13.927,420.914,23.527,432.914]},{"c":"暗","bbox":[23.527,420.914,33.127,432.914]},{"c":"中","bbox":[33.127,420.914,42.727,432.914]},{"c":"盡","bbox":[42.727,420.914,52.327,432.914]},{"c":"取","bbox":[52.327,420.914,61.927,432.914]},{"c":"受","bbox":[61.927,420.914,71.527,432.914]}]},
